# 収集・要約スクリプト用（サーバー側専用・アプリにはバンドルされません）
# Gemini / OpenAI / Claude / OpenRouter のいずれのAPIキーでも自動判別して
# 日本語＋英語のネイティブ要約を1回の呼び出しで生成します
SUMMARY_PROVIDER=gemini
# 無料枠の既定: gemini-3.1-flash-lite
# 比較例: gemini-3.8-flash / gemini-3.6-flash / gemini-3.5-flash-lite
SUMMARY_MODEL=gemini-3.1-flash-lite
SUMMARY_API_KEY=

# 1日の最大収集件数（既定 America/Los_Angeles＝Gemini RPD。中間450＝余白約50）
MAX_ARTICLES_PER_DAY=450
# 1時間あたり上限（既定19 ≒ 450/24。前倒し消費を防ぐ）
MAX_ARTICLES_PER_HOUR=19
# 1回の実行で追加する件数（既定4。15分cron×時間バジェット）
MAX_ARTICLES_PER_RUN=4
# LLM呼び出しの間隔（ミリ秒）。429対策
INGEST_ARTICLE_DELAY_MS=4000
# クォータ日のタイムゾーン（Gemini RPD に合わせる）
INGEST_QUOTA_TIMEZONE=America/Los_Angeles
# レート制限が連続したら実行停止（空打ち防止）
INGEST_RATE_LIMIT_STOP_STREAK=2
MAX_MONTHLY_COST_JPY=3000

# 既存 articles.json へ英語ネイティブ要約を後付けする場合
# npm run backfill:en
# BACKFILL_LIMIT=50

# 品質確認: npm run quality:check
# 自動更新: GitHub Actions「Ingest AI news (JA+EN)」+ Secret SUMMARY_API_KEY
# Actions Variables 推奨: SUMMARY_MODEL / MAX_ARTICLES_PER_DAY=450 / MAX_ARTICLES_PER_HOUR=19 / MAX_ARTICLES_PER_RUN=4

# アプリ配信用（本番は raw.githubusercontent.com 等の静的URLを推奨）
# 例: https://raw.githubusercontent.com/<owner>/<repo>/main/data/articles.json
# 未設定でも開発中は Metro の public/articles.json を自動取得する
EXPO_PUBLIC_FEED_URL=
